#TOKENS
SC_BEARER=sc-bearer
# CELERY
CELERY_BROKER=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULTS_BACKEND=rpc://
CELERY_TIMEZONE=Europe/Madrid
FLOWER_PORT=5555
# FLASK
FLASK_ENV=production
FLASK_APP=scflows
FLOWER_BASIC_AUTH=user:pass
FLASK_DEBUG=0
# Keep the user, password and database in line with POSTGRES_* below
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://flows:change-me@postgres:5432/flows
FLASK_SECRET_KEY=change-me
# POSTGRES
POSTGRES_USER=flows
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flows
#WEB
DOMAIN=domain.com
# Public address used in API links
PUBLIC_URL=https://domain.com
# Processing metadata (hardware, blueprints, calibrations) for smartcitizen-connector and scdata
BASE_POSTPROCESSING_URL=https://domain.com/api/v1/
#BACKUPS
S3_DATA_BUCKET=bucket-name
AWS_ACCESS_KEY_ID=key-id
AWS_SECRET_ACCESS_KEY=secret-key
AWS_DEFAULT_REGION=eu-west-1
